<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows + UseWPF is what supplies UIAutomationClient / UIAutomationTypes,
         the same assemblies DriveApp.ps1 loads with Add-Type. NOTE: UseWPF swaps in the
         WPF implicit-usings set, which does NOT include System.IO — import it explicitly. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Supplies System.Windows.Forms.SendKeys (used by send_keys and the focus-and-type
         fallback) and System.Drawing for the screenshot tool. UseWPF alone does not. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DialogEditor.UiaMcp.Core\DialogEditor.UiaMcp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EditorSession, UiaTree and the tool classes are internal; the Gui test project
         drives them directly rather than over JSON-RPC. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DialogEditor.UiaMcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
