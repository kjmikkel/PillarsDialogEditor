<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Docking Shell Phase 1, Task 7: retints Dock.Avalonia.Themes.Fluent's chrome onto the
         app's Brush.* design tokens instead of stock Dock Fluent grey.

         KEY DISCOVERY: the installed Dock.Avalonia.Themes.Fluent 11.3.12.1 package embeds its
         axaml as compiled XamlIl (no plain-text .axaml ships in the nupkg), so the override
         key names below were read by decompiling the theme assembly
         (dock.avalonia.themes.fluent/11.3.12.1/lib/net8.0/Dock.Avalonia.Themes.Fluent.dll)
         with ilspycmd (-p project mode) and grepping the generated
         CompiledAvaloniaXaml/-AvaloniaResources.cs for every `AddDeferred((object)"...")` /
         `ResourceKey = "..."` resource-dictionary key the theme registers. That enumerates the
         theme's full public brush surface (tab strip, surfaces, splitters, target overlay,
         floating host-window chrome, chrome buttons) with certainty — no guessing at names.
         Every key below is Brush-typed in the theme (confirmed by the "...Brush" suffix and by
         the theme's own Background/Foreground/BorderBrush setters consuming it via
         {DynamicResource <key>}), so each override retints the Dock key using the app's
         corresponding Brush.* token's colour.

         FIX (runtime cast crash, fix pass 2): the original alias form
         `<DynamicResource x:Key="DockX" ResourceKey="Brush.Y"/>` does NOT work in Avalonia — a
         resource whose stored VALUE is itself a `{DynamicResource}` markup extension does not
         transparently forward on lookup; the lookup returns the DynamicResourceExtension OBJECT
         itself, not the brush it points to. When Dock's compiled theme consumed one of these
         keys directly as an IBrush (e.g. a Background/BorderBrush setter reading the resource),
         it received the extension object instead and threw
         `InvalidCastException: Unable to cast object of type 'DynamicResourceExtension' to type
         'Avalonia.Media.IBrush'` — surfacing during dock layout measure, through
         Dock.Controls.ProportionalStackPanel / Dock.Controls.DeferredContentControl. Each entry
         is therefore now a CONCRETE `<SolidColorBrush x:Key="DockX" Color="{DynamicResource
         Palette.Y}"/>`: a real IBrush is stored under the Dock key (fixing the cast), while its
         Color still re-resolves against the live Palette.* token when ThemeApplier swaps the
         palette wrapper at runtime, preserving live retint. Colors are drawn from the same
         Palette.* key each corresponding Brush.* token itself uses (see Tokens.axaml), so this
         stays hex-free (NoStrayHexTests scans every non-palette .axaml in the solution). -->

    <!-- Base theme roles (background/control-background/border/accent/foreground) — the
         theme's own low-level palette, mostly superseded below by more specific keys but
         still consulted by a handful of default control templates. -->
    <SolidColorBrush x:Key="DockThemeBackgroundBrush"        Color="{DynamicResource Palette.Neutral.115}"/>
    <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="{DynamicResource Palette.Neutral.100}"/>
    <SolidColorBrush x:Key="DockThemeBorderLowBrush"         Color="{DynamicResource Palette.Line.Subtle}"/>
    <SolidColorBrush x:Key="DockThemeAccentBrush"             Color="{DynamicResource Palette.Azure.600}"/>
    <SolidColorBrush x:Key="DockThemeForegroundBrush"        Color="{DynamicResource Palette.Neutral.910}"/>

    <!-- Surfaces — the panel backgrounds behind the workbench, sidebars, document area and
         tool/document group headers. -->
    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush"    Color="{DynamicResource Palette.Neutral.115}"/>
    <SolidColorBrush x:Key="DockSurfaceEditorBrush"       Color="{DynamicResource Palette.Neutral.145}"/>
    <SolidColorBrush x:Key="DockSurfacePanelBrush"        Color="{DynamicResource Palette.Neutral.145}"/>
    <SolidColorBrush x:Key="DockSurfaceSidebarBrush"      Color="{DynamicResource Palette.Neutral.145}"/>
    <SolidColorBrush x:Key="DockSurfaceHeaderBrush"       Color="{DynamicResource Palette.Neutral.200}"/>
    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="{DynamicResource Palette.Neutral.175}"/>

    <!-- Tool/document tab strip (tab chrome, not the tool dock's Left/Right/Bottom placement,
         which is set on ToolDock itself in EditorDockFactory / already default per Step 3). -->
    <SolidColorBrush x:Key="DockTabBackgroundBrush"              Color="{DynamicResource Palette.Neutral.175}"/>
    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush"         Color="{DynamicResource Palette.Neutral.265}"/>
    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush"        Color="{DynamicResource Palette.Neutral.100}"/>
    <SolidColorBrush x:Key="DockTabForegroundBrush"              Color="{DynamicResource Palette.Neutral.800}"/>
    <SolidColorBrush x:Key="DockTabActiveForegroundBrush"        Color="{DynamicResource Palette.Neutral.910}"/>
    <SolidColorBrush x:Key="DockTabSelectedForegroundBrush"      Color="{DynamicResource Palette.Neutral.910}"/>
    <!-- Active-tab underline/indicator: the app's primary accent, so the selected tab reads
         as "on" the same way a primary action button does. -->
    <SolidColorBrush x:Key="DockTabActiveIndicatorBrush"         Color="{DynamicResource Palette.Azure.600}"/>
    <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush"    Color="{DynamicResource Palette.Neutral.290}"/>

    <!-- Document tab strip (the centre document dock — Conversations canvas today). -->
    <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush"            Color="{DynamicResource Palette.Neutral.200}"/>
    <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush"         Color="{DynamicResource Palette.Neutral.910}"/>
    <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush"      Color="{DynamicResource Palette.Neutral.865}"/>
    <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="{DynamicResource Palette.Red.550}"/>
    <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush"    Color="{DynamicResource Palette.Neutral.910}"/>
    <SolidColorBrush x:Key="DockDocumentContentBorderBrush"                 Color="{DynamicResource Palette.Line.Default}"/>

    <!-- Splitters between docks. -->
    <SolidColorBrush x:Key="DockSplitterIdleBrush"  Color="{DynamicResource Palette.Line.Subtle}"/>
    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="{DynamicResource Palette.Line.Strong}"/>
    <SolidColorBrush x:Key="DockSplitterDragBrush"  Color="{DynamicResource Palette.Azure.600}"/>

    <!-- General borders/separators. -->
    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="{DynamicResource Palette.Line.Subtle}"/>
    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="{DynamicResource Palette.Line.Strong}"/>
    <SolidColorBrush x:Key="DockSeparatorBrush"    Color="{DynamicResource Palette.Line.Default}"/>

    <!-- Drag/drop target overlay (the docking-guide highlight shown while dragging a tab) and
         the tab-picker overlay backdrop. -->
    <SolidColorBrush x:Key="DockTargetIndicatorBrush"         Color="{DynamicResource Palette.Azure.600}"/>
    <SolidColorBrush x:Key="DockSelectorOverlayBackdropBrush" Color="{DynamicResource Palette.Alpha.Scrim}"/>

    <!-- Application accent family — hover/pressed/full-strength intensities for
         accent-tinted interactive elements, and the accent foreground (text/icon colour that
         sits on top of a full-strength accent fill). -->
    <SolidColorBrush x:Key="DockApplicationAccentBrushLow"        Color="{DynamicResource Palette.Neutral.265}"/>
    <SolidColorBrush x:Key="DockApplicationAccentBrushMed"        Color="{DynamicResource Palette.Neutral.290}"/>
    <SolidColorBrush x:Key="DockApplicationAccentBrushHigh"       Color="{DynamicResource Palette.Azure.600}"/>
    <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator"  Color="{DynamicResource Palette.Azure.600}"/>
    <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="{DynamicResource Palette.White}"/>

    <!-- Floating host-window chrome (title bar + window border) — EditorHostWindow inherits
         the app theme via these merged dictionaries, so a floated tool/document matches the
         docked chrome instead of falling back to stock Dock Fluent grey. -->
    <SolidColorBrush x:Key="DockWindowChromeBackgroundBrush"         Color="{DynamicResource Palette.Neutral.200}"/>
    <SolidColorBrush x:Key="DockWindowChromeBorderBrush"             Color="{DynamicResource Palette.Line.Strong}"/>
    <SolidColorBrush x:Key="DockWindowChromeForegroundBrush"         Color="{DynamicResource Palette.Neutral.910}"/>
    <SolidColorBrush x:Key="DockWindowChromeTitleBarBackgroundBrush" Color="{DynamicResource Palette.Neutral.200}"/>

    <!-- Floating window chrome buttons (pin/minimize/maximize/close) and the drag grip. -->
    <SolidColorBrush x:Key="DockChromeButtonForegroundBrush"        Color="{DynamicResource Palette.Neutral.910}"/>
    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush"   Color="{DynamicResource Palette.Neutral.265}"/>
    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="{DynamicResource Palette.Neutral.290}"/>
    <!-- Close-button hover reads as destructive, matching the app's other destructive/danger
         accents (e.g. GitConflictResolutionWindow's Theirs/error tone). -->
    <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush"       Color="{DynamicResource Palette.Red.550}"/>
    <SolidColorBrush x:Key="DockChromeGripBrush"                    Color="{DynamicResource Palette.Line.Muted}"/>

    <!-- Tool-window chrome icon (the small icon in a tool tab's chrome, if content supplies one). -->
    <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="{DynamicResource Palette.Neutral.800}"/>

</ResourceDictionary>
