<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ─── Patch Manager strings — canonical, shared by editor and standalone ── -->

    <!-- Labels and button content -->
    <sys:String x:Key="PatchManager_Title">Patch Manager</sys:String>
    <sys:String x:Key="PatchManager_GameFolder">Game folder</sys:String>
    <sys:String x:Key="PatchManager_GameFolderWatermark">(no game folder selected)</sys:String>
    <sys:String x:Key="PatchManager_BrowseGame">Browse…</sys:String>
    <sys:String x:Key="PatchManager_LoadOrder">Load Order</sys:String>
    <sys:String x:Key="PatchManager_SaveLoadOrder">Save load order…</sys:String>
    <sys:String x:Key="PatchManager_LoadLoadOrder">Load load order…</sys:String>
    <sys:String x:Key="PatchManager_AddProjects">Add projects…</sys:String>
    <sys:String x:Key="PatchManager_Apply">Apply patches</sys:String>
    <sys:String x:Key="PatchManager_Applying">Applying…</sys:String>
    <!-- Remove all mods / backup status (issue #76) -->
    <sys:String x:Key="PatchManager_RemoveAllMods">Remove all mods</sys:String>
    <sys:String x:Key="PatchManager_NoModsInstalled">No mods installed with the Patch Manager or dialog-patcher yet.</sys:String>
    <sys:String x:Key="PatchManager_ModsInstalled_One">Mods are installed: the patcher manages 1 game file and can put it back as it was.</sys:String>
    <sys:String x:Key="PatchManager_ModsInstalled_Other">Mods are installed: the patcher manages {0} game files and can put them back as they were.</sys:String>
    <sys:String x:Key="PatchManager_BackupCorrupt">The patcher's backup record is unreadable ({0}). Nothing was changed. Verify the game files in your storefront, then delete the PillarsDialogPatcher folder.</sys:String>
    <sys:String x:Key="PatchManager_ApplyCancelledExternal">Apply cancelled — nothing was changed.</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllDone_One">Removed all mods: 1 game file is back as it was.</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllDone_Other">Removed all mods: {0} game files are back as they were.</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllPartial">Removed mods: {0} files restored; {1} left as is because something else changed them (see the log).</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllError">Remove all mods failed: {0}</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllConfirm_Title">Remove all mods?</sys:String>
    <sys:String x:Key="PatchManager_RemoveAllConfirm_Message">Every game file the Patch Manager or dialog-patcher changed is put back to its original, and the files they added are deleted. Your load order stays in the list, so you can apply it again later.</sys:String>
    <sys:String x:Key="PatchManager_ExternalChanges_Title">Game files changed outside the Patch Manager</sys:String>
    <sys:String x:Key="PatchManager_ExternalChanges_Message">These files were changed by something other than the Patch Manager — usually a game update or "verify files", sometimes another mod tool. Treat their current contents as the new originals and apply your load order on top of them?</sys:String>
    <sys:String x:Key="PatchManager_ExternalChanges_Confirm">Treat as new originals</sys:String>
    <sys:String x:Key="PatchManager_ExternalChanges_More">…and {0} more</sys:String>
    <sys:String x:Key="Confirm_Cancel">Cancel</sys:String>
    <sys:String x:Key="ToolTip_RemoveAllMods">Undo every mod installed into this game folder: restore each game file the patcher changed to its original version and delete the files it added. The load order list is kept.</sys:String>
    <sys:String x:Key="PatchManager_EmptyHint">Add .dialogproject files above. Lower entries win on conflict.</sys:String>
    <sys:String x:Key="PatchManager_OrderHint">↑ First applied   ↓ Last applied (wins on conflict)</sys:String>

    <!-- Status and error messages (used via Loc.Get/Format) -->
    <sys:String x:Key="PatchManager_NoConflicts">No conflicts detected.</sys:String>
    <sys:String x:Key="PatchManager_ConflictsFound_One">1 conflict detected — reorder so the version you want is lowest in the list.</sys:String>
    <sys:String x:Key="PatchManager_ConflictsFound_Other">{0} conflicts detected — reorder so the version you want is lowest in the list.</sys:String>
    <sys:String x:Key="PatchManager_ApplySuccess_One">Applied 1 patch to {1}.</sys:String>
    <sys:String x:Key="PatchManager_ApplySuccess_Other">Applied {0} patches to {1}.</sys:String>
    <sys:String x:Key="PatchManager_ApplyError">Apply failed: {0}</sys:String>
    <sys:String x:Key="PatchManager_LoadError">Could not load '{0}': {1}</sys:String>
    <!-- One line of the conflict summary list. {0} is the conversation name, {1} the node
         id, {2} the field the patches disagree about (or one of the PatchManager_*Field
         markers below), {3} and {4} the names of the two clashing projects in load order.
         The middle dots are separators, not words; reorder the holes as the language
         needs. -->
    <sys:String x:Key="PatchManager_ConflictRow">conversation '{0}' · node {1} · {2} · between '{3}' and '{4}'</sys:String>
    <!-- Shown in place of a field name when one patch deletes the node another patch
         modifies, so there is no single field to name. Display only - the conflict is
         identified by its data, so any wording is safe. -->
    <sys:String x:Key="PatchManager_DeletedField">(deleted)</sys:String>
    <!-- Shown in place of a field name when two projects each add a NEW node under the same
         id, so the later one replaces the earlier one entirely. Display only. -->
    <sys:String x:Key="PatchManager_AddedNodeField">(added by both)</sys:String>
    <!-- Shown in place of a field name when two projects add or change the same link.
         {0} is the id of the node the link leads to (the row's node is where it starts). -->
    <sys:String x:Key="PatchManager_LinkField">link to node {0}</sys:String>
    <!-- Shown in place of a field name when two projects both rewrite the same line's text
         in the same language, so the later one's text replaces the earlier one's.
         {0} is the language code, e.g. "en" or "fr". Display only. -->
    <sys:String x:Key="PatchManager_TextField">text ({0})</sys:String>
    <sys:String x:Key="PatchManager_EntryConflict">⚠ conflicts with another project</sys:String>
    <sys:String x:Key="PatchManager_EntryConflictDetail">Conflicts with another project — move lower to override the other, or higher to be overridden</sys:String>
    <sys:String x:Key="PatchManager_EntryLoadError">⚠ could not load</sys:String>
    <sys:String x:Key="ToolTip_PatchManagerOpen">Open the Patch Manager to combine and apply multiple .dialogproject files in a defined load order</sys:String>

    <!-- Tooltips -->
    <sys:String x:Key="ToolTip_BrowseGameFolder">Select the root folder of your PoE1 or PoE2 installation</sys:String>
    <sys:String x:Key="ToolTip_AddProjects">Add one or more .dialogproject files to the load order</sys:String>
    <sys:String x:Key="ToolTip_SaveLoadOrder">Save the current load order to a .patchlist file for later reuse</sys:String>
    <sys:String x:Key="ToolTip_LoadLoadOrder">Open a previously saved .patchlist file</sys:String>
    <sys:String x:Key="ToolTip_MoveEntryUp">Move up — lower index is applied first; lower position wins on conflict</sys:String>
    <sys:String x:Key="ToolTip_MoveEntryDown">Move down — lower position in the list wins on conflict</sys:String>
    <sys:String x:Key="ToolTip_RemoveEntry">Remove from load order</sys:String>
    <sys:String x:Key="ToolTip_ApplyPatches">Reset the game to its original files, then apply every patch in load order. Lower entries win on conflict. Removing a project from the list and applying again removes that mod.</sys:String>

    <!-- FileType descriptions (used by file pickers) -->
    <sys:String x:Key="FileType_PatchList">Patch list (*.patchlist)</sys:String>

    <!-- ─── Accessibility — screen-reader names for icon-only buttons ─────────── -->
    <sys:String x:Key="AutomationName_MovePatchUp">Move patch up</sys:String>
    <sys:String x:Key="AutomationName_MovePatchDown">Move patch down</sys:String>
    <sys:String x:Key="AutomationName_RemovePatch">Remove patch</sys:String>

    <!-- ─── Theme picker (Layer 2) — shared by editor and standalone PatchManager ── -->
    <sys:String x:Key="Settings_Theme">Theme</sys:String>
    <sys:String x:Key="Settings_ThemeTooltip">Choose the colour theme for the whole application. The change is applied immediately and remembered for next time. High Contrast and Colourblind improve readability for low vision and colour-vision deficiency.</sys:String>
    <sys:String x:Key="Theme_Name_Auto">System Default</sys:String>
    <sys:String x:Key="Theme_Name_Dark">Dark</sys:String>
    <sys:String x:Key="Theme_Name_Light">Light</sys:String>
    <sys:String x:Key="Theme_Name_Colourblind">Colourblind</sys:String>
    <sys:String x:Key="Theme_Name_HighContrast">High Contrast</sys:String>

    <!-- ─── Language picker — shared by editor and standalone PatchManager ──────── -->
    <sys:String x:Key="Settings_Language">Language</sys:String>
    <sys:String x:Key="Settings_LanguageTooltip">Choose the application language. The change is applied immediately and remembered for next time.</sys:String>
    <sys:String x:Key="Settings_Language_English">English</sys:String>

    <!-- ─── Settings section headers — shared by editor and PatchManagerSettingsWindow ── -->
    <sys:String x:Key="Settings_AppearanceSection">Appearance</sys:String>
    <sys:String x:Key="Settings_LanguageSection">Language</sys:String>
    <sys:String x:Key="Settings_Close">Close</sys:String>

    <!-- ─── First-run theme onboarding (Gaps item 15) — shared by editor and standalone PatchManager ── -->
    <sys:String x:Key="ThemeOnboarding_Title">Choose a Theme</sys:String>
    <sys:String x:Key="ThemeOnboarding_Intro">Pick a colour theme below — you can change this anytime later in Settings.</sys:String>
    <sys:String x:Key="ThemeOnboarding_PreviewLabel">Preview</sys:String>
    <sys:String x:Key="ThemeOnboarding_Continue">Continue</sys:String>
    <sys:String x:Key="ThemeOnboarding_Card_Npc">NPC</sys:String>
    <sys:String x:Key="ThemeOnboarding_Card_Player">Player</sys:String>
    <sys:String x:Key="ThemeOnboarding_Card_Narrator">Narrator</sys:String>
    <sys:String x:Key="ThemeOnboarding_Sample_Npc">"The road north is closed," the guard says.</sys:String>
    <sys:String x:Key="ThemeOnboarding_Sample_Player">[Persuade] Let us through — it's urgent.</sys:String>
    <sys:String x:Key="ThemeOnboarding_Sample_Narrator">The guard eyes you warily, hand on his sword.</sys:String>
    <sys:String x:Key="ThemeOnboarding_Badge_Warning">Warning</sys:String>
    <sys:String x:Key="ThemeOnboarding_Badge_Error">Error</sys:String>
    <sys:String x:Key="ThemeOnboarding_Button_Primary">Primary</sys:String>
    <sys:String x:Key="ThemeOnboarding_Button_Destructive">Destructive</sys:String>
    <sys:String x:Key="ThemeOnboarding_Button_Plain">Plain</sys:String>

    <!-- ─── File-format version checks (GitHub issues 62, 104) — editor and Patch Manager ── -->
    <sys:String x:Key="Schema_TooNew_Title">Newer file format</sys:String>
    <!-- {0} file name, {1} format name, {2} version in the file, {3} highest version this build reads -->
    <sys:String x:Key="Schema_TooNew">'{0}' was saved by a newer version of Pillars Dialog Editor ({1} {2}). This version reads up to {1} {3}. Update to the latest version to open it.</sys:String>
    <!-- as above; {4} conversation name -->
    <sys:String x:Key="Schema_TooNewInConversation">'{0}' contains conversation '{4}' saved by a newer version of Pillars Dialog Editor ({1} {2}). This version reads up to {1} {3}. Update to the latest version to open it.</sys:String>
    <sys:String x:Key="Schema_Format_Project">project format</sys:String>
    <sys:String x:Key="Schema_Format_ConversationPatch">conversation patch format</sys:String>
    <sys:String x:Key="Schema_Format_PatchList">load-order format</sys:String>
    <sys:String x:Key="Schema_TooNew_Ok">OK</sys:String>

    <!-- ─── Standalone Patch Manager: a mod needs a newer patcher (GitHub issue 79) ── -->
    <!-- {0} file name, {1} format name, {2} version in the file, {3} highest version this build reads -->
    <sys:String x:Key="Schema_TooNewForPatcher">'{0}' needs a newer Pillars Dialog Patcher ({1} {2}). This version reads up to {1} {3}. Nothing was changed.</sys:String>
    <!-- as above; {4} conversation name -->
    <sys:String x:Key="Schema_TooNewForPatcherInConversation">'{0}' contains conversation '{4}', which needs a newer Pillars Dialog Patcher ({1} {2}). This version reads up to {1} {3}. Nothing was changed.</sys:String>
    <sys:String x:Key="PatchManager_GetLatestPatcher">Get the latest patcher</sys:String>
    <sys:String x:Key="ToolTip_GetLatestPatcher">Open the Pillars Dialog Patcher releases page in your browser. Download the newest version to install mods made with a newer editor.</sys:String>
    <sys:String x:Key="PatchManager_OpenReleasesFailed">Couldn't open the releases page. Please check your internet connection or browser.</sys:String>

</ResourceDictionary>