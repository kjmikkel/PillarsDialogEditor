<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DialogEditor.Avalonia.Converters"
             xmlns:docking="clr-namespace:DialogEditor.Avalonia.Docking"
             xmlns:views="clr-namespace:DialogEditor.Avalonia.Views"
             x:Class="DialogEditor.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme/>
        <!-- Dock.Avalonia's own Fluent theme (Dock.Avalonia.Themes.Fluent package) — required
             for DockControl and its child views (tool/document tabs, splitters, etc.) to render.
             Task 1 of Docking Shell Phase 1: theme merged now, no DockControl exists yet.
             StyleInclude (not the <DockFluentTheme .../> element form) is used because
             Avalonia's XAML compiler in this version rejects xmlns declarations on
             non-root elements (AXN0002), which the element form requires. -->
        <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Layer 0 token registry lives in the SHARED project so BOTH the editor
                     and the standalone PatchManager app resolve the same Brush.* keys
                     (the shared PatchManagerView is hosted by both). -->
                <ResourceInclude Source="avares://DialogEditor.Avalonia.Shared/Resources/Palette.Dark.axaml"/>
                <ResourceInclude Source="avares://DialogEditor.Avalonia.Shared/Resources/Tokens.axaml"/>
                <ResourceInclude Source="avares://Nodify/Theme.axaml"/>
                <ResourceInclude Source="avares://DialogEditor.Avalonia/Resources/Strings.axaml"/>
                <ResourceInclude Source="avares://DialogEditor.Avalonia.Shared/Resources/SharedStrings.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ToolbarPlainButton / ToolbarPlainToggleButton
                 Minimal control themes for icon-only toolbar buttons.
                 Only Background changes on hover/press — no border, no padding
                 change, no size change. TargetType is required so TemplateBinding
                 resolves Padding correctly. -->
            <ControlTheme x:Key="ToolbarPlainButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Toolbar.Button.Foreground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Hover}"/>
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Pressed}"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="ToolbarPlainToggleButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Toolbar.Button.Foreground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Hover}"/>
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Pressed}"/>
                </Style>
                <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.Checked}"/>
                </Style>
                <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Button.CheckedHover}"/>
                </Style>
            </ControlTheme>

            <converters:FloatDecimalConverter           x:Key="FloatDecimal"/>
            <converters:QTDDisplayConverter             x:Key="QTDDisplay"/>
            <converters:LayoutPointConverter             x:Key="LayoutPointConverter"/>
            <converters:SpeakerCategoryToBrushConverter x:Key="SpeakerCategoryToBrush"/>
            <converters:NodeColorConverter              x:Key="NodeColorConverter"/>
            <converters:NodeTypeShapeConverter          x:Key="NodeTypeShape"/>
            <converters:BoolToFemaleTextBrushConverter      x:Key="BoolToFemaleTextBrush"/>
            <converters:BoolToVoStatusBrushConverter         x:Key="BoolToVoStatusBrush"/>
            <converters:BoolToNewConversationBrushConverter x:Key="BoolToNewConversationBrush"/>
            <converters:InverseBoolConverter            x:Key="InverseBoolToVis"/>
            <converters:NullOrEmptyToBoolConverter      x:Key="NullOrEmptyToVis"/>
            <converters:CountToBoolConverter            x:Key="CountToVis"/>
            <converters:BoolToOpacityConverter          x:Key="SearchMatchOpacity"/>
            <converters:StringEqualsBoolConverter           x:Key="StringEqualsBool"/>
            <converters:PropertyValueStyleToBrushConverter x:Key="PropertyValueStyleToBrush"/>
            <converters:FlowIssueKindToSeverityBrushConverter x:Key="FlowIssueSeverityBrush"/>
            <converters:BalanceFlagToBrushConverter             x:Key="BalanceFlagToBrush"/>
            <converters:SearchMatchStateToOpacityConverter      x:Key="SearchStateOpacity"/>
            <converters:SearchMatchStateToBorderBrushConverter  x:Key="SearchMatchBorderBrush"/>
            <converters:FlowIssueKindToSeverityGlyphConverter   x:Key="FlowIssueSeverityGlyph"/>
            <converters:DiffStatusToBrushConverter              x:Key="DiffStatusToBrushConverter"/>
            <converters:DiffStatusToGlyphConverter               x:Key="DiffStatusToGlyph"/>
            <converters:CommitDateConverter                      x:Key="CommitDate"/>
            <converters:EnumToBoolConverter                      x:Key="EnumToBool"/>
            <converters:IsNullConverter                          x:Key="IsNull"/>
            <converters:IsNotNullConverter                       x:Key="IsNotNull"/>
            <converters:FontScaleToPercentConverter              x:Key="FontScaleToPercent"/>

        </ResourceDictionary>
    </Application.Resources>

    <!-- Dock tool/document wrapper VMs (DialogEditor.Avalonia.Docking) render by
         unwrapping their Inner property into the pre-existing panel views. No
         layout/factory yet (Task 3) — just the templates so the wrappers are
         displayable once a DockControl exists. -->
    <Application.DataTemplates>
        <DataTemplate DataType="docking:BrowserTool">
            <views:GameBrowserView DataContext="{Binding Inner}"/>
        </DataTemplate>
        <DataTemplate DataType="docking:DetailsTool">
            <views:NodeDetailView DataContext="{Binding Inner}"/>
        </DataTemplate>
        <DataTemplate DataType="docking:ConditionSearchTool">
            <views:ConditionSearchView DataContext="{Binding Inner}"/>
        </DataTemplate>
        <DataTemplate DataType="docking:CanvasDocument">
            <views:ConversationView DataContext="{Binding Inner}"/>
        </DataTemplate>
    </Application.DataTemplates>

</Application>
