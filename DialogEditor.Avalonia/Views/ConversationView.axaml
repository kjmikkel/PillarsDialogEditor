<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:DialogEditor.Avalonia.Behaviors"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:DialogEditor.ViewModels;assembly=DialogEditor.ViewModels"
             xmlns:models="clr-namespace:DialogEditor.Core.Models;assembly=DialogEditor.Core"
             xmlns:theming="clr-namespace:DialogEditor.Avalonia.Shared.Theming;assembly=DialogEditor.Avalonia.Shared"
             xmlns:local="clr-namespace:DialogEditor.Avalonia.Views"
             xmlns:ctrl="clr-namespace:DialogEditor.Avalonia.Controls"
             x:Class="DialogEditor.Avalonia.Views.ConversationView" x:CompileBindings="False">

    <UserControl.Resources>
        <!-- Issue 82: one port dot shared by NodeInput and NodeOutput. 16x16 hit area around an 8 px dot,
             so ports are no harder to grab than before. -->
        <ControlTemplate x:Key="PortDotTemplate">
            <Border Width="16" Height="16" Background="Transparent">
                <Ellipse Width="8" Height="8"
                         Fill="{DynamicResource Brush.Connection.Default}"
                         Stroke="{DynamicResource Brush.Canvas.Background}" StrokeThickness="1.5"/>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Issue 82: no connector side columns. Nodify's default Node draws Input/Output in
             padded columns with their own background, which took about a third of the node's
             width. The card's own colours (ContentBrush/HeaderBrush) are unused: the DataTemplate
             draws the card. -->
        <Style Selector="nodify|Node">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ContentBrush" Value="Transparent"/>
            <Setter Property="HeaderBrush" Value="Transparent"/>
            <Setter Property="FooterBrush" Value="Transparent"/>
            <!-- Nodify's Node clips to its bounds; the 18 px diff / connect-source badges sit half outside the card. -->
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <!-- Two styles, not a comma selector: ConnectorTemplate is declared on NodeInput and NodeOutput
             separately, so a combined selector infers the common base (Connector) and fails to compile. -->
        <!-- Margins centre each dot on the card's edge: the 5 px side column holds the NodeInput/Output
             (21 wide = 16 dot + 5 spacing), and the output draws its dot on the right of that spacing. -->
        <Style Selector="nodify|NodeInput">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-3,6,-13,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="ConnectorTemplate" Value="{StaticResource PortDotTemplate}"/>
        </Style>
        <Style Selector="nodify|NodeOutput">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-13,6,-3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="ConnectorTemplate" Value="{StaticResource PortDotTemplate}"/>
        </Style>

        <!-- Connection stroke colours — driven by CSS classes set in code -->
        <Style Selector="nodify|Connection">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Default}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
        <Style Selector="nodify|Connection.always">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Always}"/>
            <Setter Property="StrokeDashArray" Value="10,2,2,2"/>
        </Style>
        <Style Selector="nodify|Connection.never">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Never}"/>
            <Setter Property="StrokeDashArray" Value="4,3"/>
        </Style>
        <Style Selector="nodify|Connection.highlighted">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Highlighted}"/>
            <Setter Property="StrokeThickness" Value="2.5"/>
        </Style>
        <Style Selector="nodify|Connection.highlighted.always">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Highlighted.Always}"/>
            <Setter Property="StrokeDashArray" Value="10,2,2,2"/>
        </Style>
        <Style Selector="nodify|Connection.highlighted.never">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Connection.Highlighted.Never}"/>
        </Style>
        <!-- Links the assumed game state rules out (View > Game State, GitHub issue 32), or hidden by an earlier link that always passes (issue 353). Opacity rather than
             a new brush so the fade composes with the always/never/highlighted classes. -->
        <Style Selector="nodify|Connection.cannotFire">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar. Bottom divider so the toolbar/canvas edge reads in every theme — a faint
             hairline in Dark/Light, a bright separator in High-Contrast (where panel and canvas
             are both dark and tone alone wouldn't separate them). -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" Padding="8,4"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Classes="secondary" Content="{DynamicResource Legend_Control_Fit}"
                            Click="FitToScreen_Click"
                            Padding="8,2"
                            ToolTip.Tip="{DynamicResource ToolTip_FitToScreen}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_FitToScreen}"/>
                    <Button Classes="secondary" Content="+"
                            Click="ZoomIn_Click"
                            Padding="8,2" Margin="4,0,0,0"
                            ToolTip.Tip="{DynamicResource ToolTip_ZoomIn}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_ZoomIn}"
                            AutomationProperties.Name="{DynamicResource AutomationName_ZoomIn}"/>
                    <Button Classes="secondary" Content="−"
                            Click="ZoomOut_Click"
                            Padding="8,2" Margin="2,0,0,0"
                            ToolTip.Tip="{DynamicResource ToolTip_ZoomOut}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_ZoomOut}"
                            AutomationProperties.Name="{DynamicResource AutomationName_ZoomOut}"/>
                    <Button Classes="secondary" Content="{DynamicResource Label_AddAnnotation}"
                            Click="AddAnnotation_Click"
                            IsVisible="{Binding IsEditable}"
                            Padding="8,2" Margin="4,0,0,0"
                            ToolTip.Tip="{DynamicResource ToolTip_AddAnnotation}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_AddAnnotation}"
                            AutomationProperties.Name="{DynamicResource AutomationName_AddAnnotation}"/>
                    <Button Classes="secondary" Content="⌂"
                            Click="CenterOnRoot_Click"
                            Padding="8,2" Margin="8,0,0,0"
                            ToolTip.Tip="{DynamicResource ToolTip_JumpToRoot}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_JumpToRoot}"
                            AutomationProperties.Name="{DynamicResource AutomationName_JumpToRoot}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatisticsText}"
                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip.Tip="{Binding StatisticsTooltip}"/>
                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Min, not fixed, sizes (issue 177): the text follows the font scale. -->
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchQuery}"
                             Watermark="{DynamicResource Placeholder_SearchNodes}"
                             AutomationProperties.Name="{DynamicResource Placeholder_SearchNodes}"
                             Background="{DynamicResource Brush.Surface.Header}" Foreground="{DynamicResource Brush.Text.Secondary}" CaretBrush="{DynamicResource Brush.Text.Secondary}"
                             BorderBrush="{DynamicResource Brush.Border.Muted}" BorderThickness="1"
                             Padding="6,2,24,2" FontSize="{DynamicResource FontSize.Body}" MinHeight="26"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"
                             ToolTip.Tip="{DynamicResource ToolTip_SearchNodes}"
                             AutomationProperties.HelpText="{DynamicResource ToolTip_SearchNodes}"/>
                    <Button Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right" MinWidth="24" MinHeight="24"
                            Content="✕" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text.Hint}" FontSize="{DynamicResource FontSize.Small}" Cursor="Hand"
                            ToolTip.Tip="{DynamicResource ToolTip_ClearSearch}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_ClearSearch}"
                            AutomationProperties.Name="{DynamicResource AutomationName_ClearSearch}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Issue 172: the game starts every conversation at node 0. Shown while this one has
             nodes but no node 0; for a conversation the project created it offers the fix.
             Avalonia gives a plain Border no automation peer, so the tooltip and help text sit
             on the message itself, whose UIA name is the visible warning. -->
        <Border Grid.Row="1" Padding="8,4" BorderThickness="0,0,0,1"
                Background="{DynamicResource Brush.Validation.Background}"
                BorderBrush="{DynamicResource Brush.Validation.Border}"
                IsVisible="{Binding ShowStartNodeWarning}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Content="{DynamicResource Canvas_ChooseStartNode}"
                            Command="{Binding ChooseStartNodeCommand}"
                            IsVisible="{Binding CanMakeStartNode}"
                            ToolTip.Tip="{DynamicResource ToolTip_ChooseStartNode}"
                            AutomationProperties.Name="{DynamicResource Canvas_ChooseStartNode}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_ChooseStartNode}"/>
                    <Button Content="{DynamicResource Canvas_CancelChooseStartNode}"
                            Command="{Binding CancelChooseStartNodeCommand}"
                            IsVisible="{Binding IsChoosingStartNode}"
                            ToolTip.Tip="{DynamicResource ToolTip_CancelChooseStartNode}"
                            AutomationProperties.Name="{DynamicResource Canvas_CancelChooseStartNode}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_CancelChooseStartNode}"/>
                </StackPanel>
                <TextBlock Text="{Binding StartNodeWarningText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Validation.Text}" TextWrapping="Wrap"
                           ToolTip.Tip="{DynamicResource ToolTip_StartNodeWarning}"
                           AutomationProperties.HelpText="{DynamicResource ToolTip_StartNodeWarning}"/>
            </DockPanel>
        </Border>

        <!-- Canvas -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <!-- Backdrop and dot grid (GitHub issue 225), drawn behind a transparent editor so the
                 dots pan and zoom with it. Transparent still hit-tests, so panning is unchanged. -->
            <ctrl:CanvasDotGrid Editor="{Binding #Editor}"
                                Background="{DynamicResource Brush.Canvas.Background}"
                                DotBrush="{DynamicResource Brush.Canvas.Grid}"
                                IsHitTestVisible="False"/>
            <!-- Issue 238: NodifyAvalonia makes the editor itself no tab stop; Tab used to reach the canvas only
                 through its ports. With the ports non-focusable the editor must be the stop, or Tab skips the
                 canvas entirely. Editor_GotFocus then restores a selection the arrow keys move from. -->
            <ctrl:CanvasEditor x:Name="Editor"
                                 Background="Transparent"
                                 ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 DoubleTapped="Editor_DoubleTapped"
                                 KeyDown="Editor_KeyDown"
                                 GotFocus="Editor_GotFocus"
                                 PointerPressed="Editor_PointerPressed"
                                 IsTabStop="True">
                <ctrl:CanvasEditor.ContextMenu>
                    <ContextMenu AutomationProperties.AutomationId="CanvasContextMenu">
                        <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_Canvas_AddNodeHere}"
                                  AutomationProperties.AutomationId="CanvasMenu_AddNodeHere"
                                  Click="CanvasMenu_AddNode_Click"
                                  IsVisible="{Binding IsEditable}"
                                  ToolTip.Tip="{DynamicResource ToolTip_Menu_Canvas_AddNodeHere}"
                                  AutomationProperties.HelpText="{DynamicResource ToolTip_Menu_Canvas_AddNodeHere}"/>
                        <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_Canvas_AddAnnotationHere}"
                                  AutomationProperties.AutomationId="CanvasMenu_AddAnnotationHere"
                                  Click="CanvasMenu_AddAnnotation_Click"
                                  IsVisible="{Binding IsEditable}"
                                  ToolTip.Tip="{DynamicResource ToolTip_Menu_Canvas_AddAnnotationHere}"
                                  AutomationProperties.HelpText="{DynamicResource ToolTip_Menu_Canvas_AddAnnotationHere}"/>
                        <Separator IsVisible="{Binding CanBatchImportVo}"/>
                        <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_BatchImportVo}"
                                  AutomationProperties.AutomationId="CanvasMenu_BatchImportVo"
                                  Command="{Binding BatchImportVoCommand}"
                                  IsVisible="{Binding CanBatchImportVo}"
                                  ToolTip.Tip="{DynamicResource ToolTip_Menu_BatchImportVo}"
                                  AutomationProperties.HelpText="{DynamicResource ToolTip_Menu_BatchImportVo}"/>
                    </ContextMenu>
                </ctrl:CanvasEditor.ContextMenu>

                <!-- Drag-to-connect: the PendingConnection control MUST live inside
                     PendingConnectionTemplate (not be assigned to the PendingConnection
                     DataContext property directly). Only when hosted via the template does
                     it find its owner NodifyEditor (GetParentOfType) and subscribe to the
                     drag events that update SourceAnchor/TargetAnchor — without that, the
                     in-progress line has no coordinates to draw and stays invisible. -->
                <ctrl:CanvasEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                        <nodify:PendingConnection
                            StartedCommand="{Binding StartCommand}"
                            CompletedCommand="{Binding CompleteCommand}"
                            Stroke="{DynamicResource Brush.Connection.Default}" StrokeThickness="2" StrokeDashArray="4,3"/>
                    </DataTemplate>
                </ctrl:CanvasEditor.PendingConnectionTemplate>

                <ctrl:CanvasEditor.ItemContainerTheme>
                    <ControlTheme TargetType="nodify:ItemContainer"
                                  BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay,
                                                   Converter={StaticResource LayoutPointConverter}}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <!-- Issue 234: no dragging in reading mode (or with no project open: the keyboard nudge
                             is already gated on IsEditable, so a pointer drag must be too). -->
                        <Setter Property="IsDraggable" Value="{Binding $parent[UserControl].DataContext.IsEditable}"/>
                        <!-- Issue 242: keyboard selection moves focus here (FollowSelection), so a screen
                             reader announces the node. Focusable but no tab stop: the editor stays the
                             canvas's single Tab stop (issue 238). -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="IsTabStop" Value="False"/>
                    </ControlTheme>
                </ctrl:CanvasEditor.ItemContainerTheme>

                <ctrl:CanvasEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                        <nodify:Node Input="{Binding Inputs}" Output="{Binding Outputs}"
                                     Tapped="Node_Tapped">

                            <nodify:Node.ContextMenu>
                                <ContextMenu AutomationProperties.AutomationId="NodeContextMenu">
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_DeleteNode}"
                                              IsVisible="{Binding !$parent[UserControl].DataContext.IsReadingMode}"
                                              AutomationProperties.AutomationId="NodeMenu_Delete"
                                              Command="{Binding $parent[UserControl].DataContext.DeleteNodeCmdCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{DynamicResource ToolTip_DeleteNode}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_DeleteNode}"/>
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_AddConnectedNode}"
                                              IsVisible="{Binding !$parent[UserControl].DataContext.IsReadingMode}"
                                              AutomationProperties.AutomationId="NodeMenu_AddConnectedNode"
                                              Command="{Binding $parent[UserControl].DataContext.AddConnectedNodeCmdCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{DynamicResource ToolTip_AddConnectedNode}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_AddConnectedNode}"/>
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_ConnectToNode}"
                                              IsVisible="{Binding !$parent[UserControl].DataContext.IsReadingMode}"
                                              AutomationProperties.AutomationId="NodeMenu_ConnectToNode"
                                              Command="{Binding $parent[UserControl].DataContext.BeginConnectCmdCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{DynamicResource ToolTip_ConnectToNode}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_ConnectToNode}"/>
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_MakeStartNode}"
                                              AutomationProperties.AutomationId="NodeMenu_MakeStartNode"
                                              Command="{Binding $parent[UserControl].DataContext.MakeStartNodeCmdCommand}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding $parent[UserControl].DataContext.CanMakeStartNode}"
                                              ToolTip.Tip="{DynamicResource ToolTip_MakeStartNode}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_MakeStartNode}"/>
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_Canvas_BrowseSpeakerLinesForNode}"
                                              AutomationProperties.AutomationId="NodeMenu_BrowseSpeakerLines"
                                              Command="{Binding $parent[UserControl].DataContext.BrowseSpeakerLinesForNodeCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{DynamicResource ToolTip_Canvas_BrowseSpeakerLinesForNode}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_Canvas_BrowseSpeakerLinesForNode}"/>
                                    <Separator IsVisible="{Binding $parent[UserControl].DataContext.Detail.ShowImportVoMenuItem}"/>
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_ImportVo}"
                                              AutomationProperties.AutomationId="NodeMenu_ImportVo"
                                              Command="{Binding $parent[UserControl].DataContext.Detail.ImportVoCommand}"
                                              ToolTip.Tip="{DynamicResource ToolTip_Menu_ImportVo}"
                                              IsVisible="{Binding $parent[UserControl].DataContext.Detail.ShowImportVoMenuItem}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_Menu_ImportVo}"/>
                                </ContextMenu>
                            </nodify:Node.ContextMenu>

                            <!-- Issue 238: ports are pointer-only drag handles. Focusable, they were two unnamed,
                                 invisible tab stops per node; the canvas is the single keyboard stop and the arrow
                                 keys move between nodes (Editor_KeyDown). Ctrl+L connects from the keyboard. -->
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                    <nodify:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource,
                                                                  Converter={StaticResource LayoutPointConverter}}"
                                                      IsConnected="True" Focusable="False"/>
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>

                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                    <nodify:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource,
                                                                   Converter={StaticResource LayoutPointConverter}}"
                                                       IsConnected="True" Focusable="False"/>
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>

                            <!-- Issue 82: Margin -16,0 cancels the 16 px left/right padding Nodify's Node template puts
                                 around its content (a local value on the template's content Border, which neither
                                 Node.Padding, ContentContainerStyle nor a style selector overrides). Without it the
                                 node is card + 32 px wide. Measured against NodifyAvalonia 6.6.0; if an upgrade changes
                                 that padding, CanvasCardRenderTests.Ports_* (node width, dot positions) will fail. -->
                            <Grid Classes="card" Width="{DynamicResource Canvas.CardWidth}" Margin="-16,0" RowDefinitions="Auto,Auto,Auto,Auto">

                                <!-- Issue 82: dimming is a canvas-coloured veil over an opaque card, not an Opacity on the
                                     card. A translucent card let connection lines show through its text. -->
                                <Border Classes="dimOverlay" Grid.Row="0" Grid.RowSpan="3"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        ZIndex="8"
                                        Background="{DynamicResource Brush.Canvas.Background}"
                                        Opacity="{Binding SearchMatchState, Converter={StaticResource SearchDimOverlayOpacity}}"/>

                                <!-- Issue 82: 1 px card outline (CardMetrics.BorderThickness). The header, body
                                     and footer are inset by it (Margin) so it never covers their content. -->
                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Node.Border}"/>

                                <!-- Search-match emphasis — highlight border on condition/script-search
                                     hits (SearchMatchState.Match); Transparent otherwise -->
                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        ZIndex="9"
                                        BorderThickness="3"
                                        BorderBrush="{Binding SearchMatchState, Converter={StaticResource SearchMatchBorderBrush}}"
                                        Background="Transparent"/>

                                <!-- Diff tint overlay — transparent when Unchanged -->
                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        ZIndex="10"
                                        BorderThickness="3"
                                        BorderBrush="{Binding DiffStatus, Converter={StaticResource DiffStatusToBrushConverter}}"
                                        Background="Transparent"/>

                                <!-- Diff status badge — corner glyph mirroring the border colour;
                                     transparent background + empty glyph when Unchanged, so it
                                     renders as nothing (Layer 2.5) -->
                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        Width="18" Height="18" CornerRadius="9"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-9,-9,0"
                                        IsHitTestVisible="False"
                                        ZIndex="11"
                                        Background="{Binding DiffStatus, Converter={StaticResource DiffStatusToBrushConverter}}">
                                    <TextBlock Text="{Binding DiffStatus, Converter={StaticResource DiffStatusToGlyph}}"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}" FontWeight="Bold" FontSize="{DynamicResource Canvas.FontSize.Badge}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Connect-mode source highlight — dashed amber border + 🔗
                                     badge, top-left (opposite the diff badge's top-right corner
                                     so the two never collide). Transparent/invisible when this
                                     node isn't the connect-mode source (Layer 2.5), reusing
                                     Brush.Severity.Warning so no new colour token is needed. -->
                                <Rectangle Grid.Row="0" Grid.RowSpan="3"
                                           IsHitTestVisible="False"
                                           ZIndex="10"
                                           Stretch="Fill"
                                           StrokeThickness="3"
                                           StrokeDashArray="6,3"
                                           Stroke="{DynamicResource Brush.Severity.Warning}"
                                           IsVisible="{Binding IsConnectionSource}"/>

                                <Border x:Name="ConnectionSourceBadge"
                                        Grid.Row="0" Grid.RowSpan="3"
                                        Width="18" Height="18" CornerRadius="9"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="-9,-9,0,0"
                                        IsHitTestVisible="False"
                                        ZIndex="11"
                                        Background="{DynamicResource Brush.Severity.Warning}"
                                        IsVisible="{Binding IsConnectionSource}">
                                    <TextBlock Text="🔗"
                                               FontSize="{DynamicResource Canvas.FontSize.Badge}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Header — amber when Bark, speaker-color when Conversation -->
                                <Border Grid.Row="0" CornerRadius="2,2,0,0" Margin="1,1,1,0">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource NodeColorConverter}">
                                            <Binding Path="SpeakerCategory"/>
                                            <Binding Path="DisplayType"/>
                                            <!-- Theme tick (ignored by the converter): re-fires this binding on a palette swap so the node retints live -->
                                            <Binding Source="{x:Static theming:ThemeService.Current}" Path="Revision"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <!-- Grid Auto,* (not a horizontal StackPanel): a StackPanel measures the title at infinite
                                         width, so TextTrimming never applied and a long title ran past the card edge. -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Node-type shape marker: shape encodes type (redundant with colour for
                                             accessibility — Layer 2.5), fill mirrors the speaker colour as before -->
                                        <Path Width="9" Height="9" Margin="6,0,4,0" VerticalAlignment="Center" Stretch="Uniform"
                                              ToolTip.Tip="{Binding SpeakerCategory}">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource NodeTypeShape}">
                                                    <Binding Path="SpeakerCategory"/>
                                                    <Binding Path="DisplayType"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <Path.Fill>
                                                <!-- MultiBinding (not a plain Binding) so the theme tick can retint the marker live on a palette swap -->
                                                <MultiBinding Converter="{StaticResource SpeakerCategoryToBrush}">
                                                    <Binding Path="SpeakerCategory"/>
                                                    <Binding Source="{x:Static theming:ThemeService.Current}" Path="Revision"/>
                                                </MultiBinding>
                                            </Path.Fill>
                                        </Path>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   Foreground="{DynamicResource Brush.Text.OnAccent}" FontWeight="Bold"
                                                   FontSize="{DynamicResource Canvas.FontSize.Header}"
                                                   LineHeight="{DynamicResource Canvas.LineHeight.Header}" Padding="0,3,6,3"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- Body -->
                                <Border Grid.Row="1" Margin="1,0">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource NodeColorConverter}" ConverterParameter="body">
                                            <Binding Path="SpeakerCategory"/>
                                            <Binding Path="DisplayType"/>
                                            <!-- Theme tick (ignored by the converter): re-fires this binding on a palette swap so the node retints live -->
                                            <Binding Source="{x:Static theming:ThemeService.Current}" Path="Revision"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <Panel>
                                        <!-- Issue 82: the card grows to fit its line, up to CardMetrics.MaxBodyLines (one line when zoomed
                                             out, GitHub issue 221), then ends in "…".
                                             Full text, not TextPreview: TextPreview's 80-character cut stays for one-line summaries
                                             elsewhere (Node Details' link list, Batch VO Import, VO Validation, the alias picker).
                                             MarkupText renders the game's <i>/<ispeech> markup as italic instead of showing the
                                             tags (GitHub issue 258); the edit field in Node Details keeps the raw text. -->
                                        <TextBlock Classes="cardBody" beh:MarkupText.Source="{Binding DefaultText}"
                                                   IsVisible="{Binding !HasTextPlaceholder}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxLines="{Binding $parent[nodify:NodifyEditor].ViewportZoom, Converter={StaticResource CardDetailConverter}, ConverterParameter=lines}"
                                                   Padding="6,4" FontSize="{DynamicResource Canvas.FontSize.Body}"
                                                   LineHeight="{DynamicResource Canvas.LineHeight.Body}"
                                                   Foreground="{DynamicResource Brush.Text.OnLight}"/>
                                        <!-- Display-only hint for empty text (#84): kept out of DefaultText so it
                                             can never be saved, exported, searched or replaced. Muted + italic,
                                             matching the footer's secondary styling. -->
                                        <TextBlock Text="{Binding TextPlaceholder}"
                                                   IsVisible="{Binding HasTextPlaceholder}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontStyle="Italic"
                                                   MaxLines="{Binding $parent[nodify:NodifyEditor].ViewportZoom, Converter={StaticResource CardDetailConverter}, ConverterParameter=lines}"
                                                   Padding="6,4" FontSize="{DynamicResource Canvas.FontSize.Body}"
                                                   LineHeight="{DynamicResource Canvas.LineHeight.Body}"
                                                   Foreground="{DynamicResource Brush.Text.OnLight.Muted}"/>
                                    </Panel>
                                </Border>

                                <!-- Footer. Hidden when zoomed out, with the body cut to one line (GitHub issue 221,
                                     CardDetail): a large hub then reads as its shape. -->
                                <Border Grid.Row="2" Padding="6,2" Margin="1,0,1,1" CornerRadius="0,0,2,2"
                                        IsVisible="{Binding $parent[nodify:NodifyEditor].ViewportZoom, Converter={StaticResource CardDetailConverter}, ConverterParameter=footer}">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource NodeColorConverter}" ConverterParameter="footer">
                                            <Binding Path="SpeakerCategory"/>
                                            <Binding Path="DisplayType"/>
                                            <!-- Theme tick (ignored by the converter): re-fires this binding on a palette swap so the node retints live -->
                                            <Binding Source="{x:Static theming:ThemeService.Current}" Path="Revision"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <TextBlock Text="{Binding FooterText}" FontSize="{DynamicResource Canvas.FontSize.Footer}"
                                               LineHeight="{DynamicResource Canvas.LineHeight.Footer}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.OnLight.Muted}"/>
                                </Border>

                            </Grid>

                        </nodify:Node>
                    </DataTemplate>
                </ctrl:CanvasEditor.ItemTemplate>

                <ctrl:CanvasEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                        <nodify:Connection
                            Source="{Binding Source.Anchor, Converter={StaticResource LayoutPointConverter}}"
                            Target="{Binding Target.Anchor, Converter={StaticResource LayoutPointConverter}}"
                            Classes.always="{Binding IsAlways}"
                            Classes.never="{Binding IsNever}"
                            Classes.highlighted="{Binding IsHighlighted}"
                            Classes.cannotFire="{Binding IsFaded}"
                            ToolTip.Tip="{Binding FadedToolTip}">
                            <nodify:Connection.ContextMenu>
                                <ContextMenu AutomationProperties.AutomationId="ConnectionContextMenu">
                                    <ctrl:AccessibleMenuItem Header="{DynamicResource Menu_DeleteConnection}"
                                              IsVisible="{Binding !$parent[UserControl].DataContext.IsReadingMode}"
                                              AutomationProperties.AutomationId="ConnectionMenu_Delete"
                                              Command="{Binding $parent[UserControl].DataContext.DeleteConnectionCmdCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{DynamicResource ToolTip_DeleteConnection}"
                                              AutomationProperties.HelpText="{DynamicResource ToolTip_DeleteConnection}"/>
                                </ContextMenu>
                            </nodify:Connection.ContextMenu>
                        </nodify:Connection>
                    </DataTemplate>
                </ctrl:CanvasEditor.ConnectionTemplate>

            </ctrl:CanvasEditor>

            <!-- Minimap -->
            <nodify:Minimap
                x:Name="Minimap"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="8"
                IsVisible="{Binding ShowMinimap}"
                IsReadOnly="False"
                Background="{DynamicResource Brush.Surface.Info}"
                ItemsSource="{Binding Nodes}"
                ViewportLocation="{Binding ViewportLocation, ElementName=Editor, Mode=TwoWay}"
                ViewportSize="{Binding ViewportSize, ElementName=Editor}"
                ToolTip.Tip="{DynamicResource ToolTip_Minimap}"
                AutomationProperties.Name="{DynamicResource AutomationName_Minimap}">
                <nodify:Minimap.ItemContainerTheme>
                    <ControlTheme TargetType="nodify:MinimapItem"
                                  BasedOn="{StaticResource {x:Type nodify:MinimapItem}}">
                        <Setter Property="Location" Value="{Binding Location,
                                           Converter={StaticResource LayoutPointConverter}}"/>
                        <Setter Property="Width" Value="{DynamicResource Canvas.CardWidth}"/>
                        <!-- 80: a typical one-to-two line card; real heights vary with the text, the minimap is only a sketch. -->
                        <Setter Property="Height" Value="80"/>
                        <Setter Property="Template">
                            <ControlTemplate TargetType="nodify:MinimapItem">
                                <Border CornerRadius="2">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource NodeColorConverter}">
                                            <Binding Path="SpeakerCategory"/>
                                            <Binding Path="DisplayType"/>
                                            <!-- Theme tick (ignored by the converter): re-fires this binding on a palette swap so the node retints live -->
                                            <Binding Source="{x:Static theming:ThemeService.Current}" Path="Revision"/>
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>
                </nodify:Minimap.ItemContainerTheme>
            </nodify:Minimap>

            <!-- Annotation overlay — above the NodifyEditor in stacking order.
                 ItemsControl background is null so empty-canvas areas are not hit-tested;
                 only the rendered annotation boxes intercept pointer events.
                 Body area within each AnnotationView is IsHitTestVisible=False so clicks
                 on the body fall through to nodes beneath.
                 RenderTransform (set in code-behind) mirrors the NodifyEditor viewport. -->
            <!-- Annotation overlay — screen-coordinate positioned (not world-coordinate +
                 RenderTransform) so items are always within Canvas layout bounds and cannot
                 be clipped by Avalonia's implicit per-element render rect.  ConversationView
                 code-behind recomputes ScreenX/Y/Width/Height on every viewport change and
                 on every world-position change (drag/resize).  The parent Grid's
                 ClipToBounds="True" provides the natural viewport boundary. -->
            <ItemsControl x:Name="AnnotationLayer"
                          ItemsSource="{Binding Annotations}"
                          IsHitTestVisible="{Binding IsEditable}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnnotationViewModel}">
                        <local:AnnotationView DeleteRequested="Annotation_DeleteRequested"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding ScreenX}"/>
                        <Setter Property="Canvas.Top"  Value="{Binding ScreenY}"/>
                        <Setter Property="Width"       Value="{Binding ScreenWidth}"/>
                        <Setter Property="Height"      Value="{Binding ScreenHeight}"/>
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>
            </ItemsControl>

        </Grid>
    </Grid>
</UserControl>
