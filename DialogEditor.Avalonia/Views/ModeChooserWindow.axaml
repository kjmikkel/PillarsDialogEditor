<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:DialogEditor.Avalonia.Shared;assembly=DialogEditor.Avalonia.Shared"
        x:Class="DialogEditor.Avalonia.Views.ModeChooserWindow"
        Title="{DynamicResource ModeChooser_Title}"
        Icon="avares://DialogEditor.Avalonia/Assets/app.ico"
        Width="760" MinWidth="440" SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Window}"
        shared:EscapeCloses.IsEnabled="True"
        x:CompileBindings="False">

    <!-- First-launch mode chooser (issue 234), the "Side by side" variant of
         docs/superpowers/specs/2026-10-26-reading-mode-mockups/mode-chooser.html.
         Closing without a pick (X, Esc) saves Reading; see ModeChooserViewModel. The panes
         are placed in the code-behind: two star columns, or one column when the window is too
         narrow for them (the text size scales the threshold). Esc uses EscapeCloses rather
         than IsCancel on a button, because neither button means "cancel". -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,18" Spacing="4">

            <TextBlock Text="{DynamicResource ModeChooser_Heading}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource ModeChooser_Lead}"
                       Foreground="{DynamicResource Brush.Text.Muted.Light}"
                       FontSize="{DynamicResource FontSize.Body}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <Grid x:Name="PanesGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                <Border x:Name="ReadingPane" Grid.Column="0" Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                        CornerRadius="6" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource ModeChooser_Reading_Glyph}"
                                       FontSize="{DynamicResource FontSize.Title}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Reading_Title}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Medium}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource ModeChooser_Reading_Body}"
                                   Foreground="{DynamicResource Brush.Text.Muted.Light}"
                                   FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="2" Spacing="2">
                            <TextBlock Text="{DynamicResource ModeChooser_Reading_Bullet1}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Reading_Bullet2}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Reading_Bullet3}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Reading is the primary button: it is also what closing the window gives. -->
                        <Button Grid.Row="4" x:Name="ReadingButton"
                                Content="{DynamicResource ModeChooser_Reading_Button}"
                                Command="{Binding ChooseReadingCommand}"
                                Background="{DynamicResource Brush.Button.Primary.Background}"
                                Foreground="{DynamicResource Brush.Text.OnAccent}" BorderThickness="0"
                                Padding="16,6" FontSize="{DynamicResource FontSize.Body}"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="{DynamicResource ToolTip_ModeChooser_Reading}"
                                AutomationProperties.HelpText="{DynamicResource ToolTip_ModeChooser_Reading}"/>
                    </Grid>
                </Border>

                <Border x:Name="EditingPane" Grid.Column="1" Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                        CornerRadius="6" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource ModeChooser_Editing_Glyph}"
                                       FontSize="{DynamicResource FontSize.Title}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Editing_Title}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Medium}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource ModeChooser_Editing_Body}"
                                   Foreground="{DynamicResource Brush.Text.Muted.Light}"
                                   FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="2" Spacing="2">
                            <TextBlock Text="{DynamicResource ModeChooser_Editing_Bullet1}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Editing_Bullet2}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource ModeChooser_Editing_Bullet3}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="4" x:Name="EditingButton" Classes="secondary"
                                Content="{DynamicResource ModeChooser_Editing_Button}"
                                Command="{Binding ChooseEditingCommand}"
                                Padding="16,6" FontSize="{DynamicResource FontSize.Body}"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="{DynamicResource ToolTip_ModeChooser_Editing}"
                                AutomationProperties.HelpText="{DynamicResource ToolTip_ModeChooser_Editing}"/>
                    </Grid>
                </Border>

            </Grid>

            <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0"
                    Margin="0,12,0,0" Padding="0,10,0,0">
                <TextBlock Text="{DynamicResource ModeChooser_Footer}"
                           Foreground="{DynamicResource Brush.Text.Muted.Light}"
                           FontSize="{DynamicResource FontSize.Label}" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
