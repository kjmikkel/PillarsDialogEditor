<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DialogEditor.ViewModels;assembly=DialogEditor.ViewModels"
        xmlns:shared="clr-namespace:DialogEditor.Avalonia.Shared;assembly=DialogEditor.Avalonia.Shared"
        x:Class="DialogEditor.Avalonia.Views.ScriptEditorWindow"
        Title="{Binding WindowTitle}"
        Icon="avares://DialogEditor.Avalonia/Assets/app.ico"
        Width="640" Height="600" MinWidth="480" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Window}"
        x:CompileBindings="False">

    <Window.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground"  Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="FontSize"    Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBlock.param-label">
            <Setter Property="Foreground"        Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="FontSize"          Value="{DynamicResource FontSize.Label}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Issue 190: the label column takes the font-scaled ColumnWidth.ParameterName in the row grid,
                 so a longer name trims (with its full text as a tooltip) instead of being cut off. -->
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            <Setter Property="Width"             Value="{DynamicResource ColumnWidth.ParameterName}"/>
        </Style>
        <Style Selector="TextBox.param-input">
            <Setter Property="Background"       Value="{DynamicResource Brush.Surface.Input}"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="AutoCompleteBox.param-input, ComboBox.param-input">
            <Setter Property="Background"       Value="{DynamicResource Brush.Surface.Input}"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Layout only: the colours come from Button.secondary (Resources/Buttons.axaml, issue 179). -->
        <Style Selector="Button.footer-btn">
            <Setter Property="Padding"         Value="20,6"/>
            <Setter Property="FontSize"        Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="MinWidth"        Value="90"/>
        </Style>
        <Style Selector="Button.footer-btn.primary">
            <Setter Property="Background" Value="{DynamicResource Brush.Button.Primary.Background}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto">

        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="14,8,14,4" Spacing="0">

                <!-- Helper template for a script row list -->
                <StackPanel.Resources>
                    <DataTemplate x:Key="ScriptRowTemplate" DataType="vm:ScriptRowViewModel">
                        <Border Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="4" Margin="0,0,0,4" Padding="10,8">
                            <StackPanel Spacing="6">
                                <!-- Row header: name + ↑↓✕ -->
                                <!-- Auto columns with MinWidth="28" buttons: a fixed 28 squeezed the glyph at 2.0x (issue 190). -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.Medium}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" MinWidth="28" Content="↑"
                                            Command="{Binding DataContext.MoveUpCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.Text.Muted.Light}" FontSize="{DynamicResource FontSize.Medium}" Padding="4"
                                            ToolTip.Tip="{DynamicResource ToolTip_MoveScriptUp}"
                                            AutomationProperties.HelpText="{DynamicResource ToolTip_MoveScriptUp}"
                                            AutomationProperties.Name="{DynamicResource AutomationName_MoveScriptUp}"/>
                                    <Button Grid.Column="2" MinWidth="28" Content="↓"
                                            Command="{Binding DataContext.MoveDownCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.Text.Muted.Light}" FontSize="{DynamicResource FontSize.Medium}" Padding="4"
                                            ToolTip.Tip="{DynamicResource ToolTip_MoveScriptDown}"
                                            AutomationProperties.HelpText="{DynamicResource ToolTip_MoveScriptDown}"
                                            AutomationProperties.Name="{DynamicResource AutomationName_MoveScriptDown}"/>
                                    <Button Grid.Column="3" MinWidth="28" Content="✕"
                                            Command="{Binding DataContext.DeleteRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.Severity.Error}" FontSize="{DynamicResource FontSize.Medium}" Padding="4"
                                            ToolTip.Tip="{DynamicResource ToolTip_DeleteScriptRow}"
                                            AutomationProperties.HelpText="{DynamicResource ToolTip_DeleteScriptRow}"
                                            AutomationProperties.Name="{DynamicResource AutomationName_RemoveScript}"/>
                                </Grid>
                                <!-- Parameters -->
                                <ItemsControl ItemsSource="{Binding Parameters}"
                                              IsVisible="{Binding Parameters.Count,
                                                          Converter={StaticResource CountToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ParameterValueViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0" MinHeight="32">
                                                <TextBlock Grid.Column="0" Classes="param-label" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/>
                                                <TextBox Grid.Column="1" Classes="param-input"
                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsVisible="{Binding IsText}"
                                                         ToolTip.Tip="{Binding TypeHint}"
                                                         AutomationProperties.HelpText="{Binding TypeHint}"
                                                         AutomationProperties.Name="{Binding Name}"/>
                                                <!-- An operator is a fixed list of plain labels, never free text (GitHub issue 266). -->
                                                <ComboBox Grid.Column="1" Classes="param-input" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding EnumOptions}"
                                                          SelectedItem="{Binding Value, Mode=TwoWay}"
                                                          IsVisible="{Binding IsFixedChoice}"
                                                          ToolTip.Tip="{Binding TypeHint}"
                                                          AutomationProperties.HelpText="{Binding TypeHint}"
                                                          AutomationProperties.Name="{Binding Name}"/>
                                                <AutoCompleteBox Grid.Column="1" Classes="param-input"
                                                              ItemsSource="{Binding EnumOptions}"
                                                              Text="{Binding Value, Mode=TwoWay}"
                                                              FilterMode="Contains"
                                                              MinimumPrefixLength="0"
                                                              IsVisible="{Binding IsFreeEnum}"
                                                              ToolTip.Tip="{Binding TypeHint}"
                                                              AutomationProperties.HelpText="{Binding TypeHint}"
                                                              AutomationProperties.Name="{Binding Name}"/>
                                                <AutoCompleteBox Grid.Column="1" Classes="param-input"
                                                              ItemsSource="{Binding Suggestions}"
                                                              Text="{Binding Value, Mode=TwoWay}"
                                                              FilterMode="Contains"
                                                              MinimumPrefixLength="0"
                                                              IsVisible="{Binding HasLookup}"
                                                              ToolTip.Tip="{Binding TypeHint}"
                                                              AutomationProperties.HelpText="{Binding TypeHint}"
                                                              AutomationProperties.Name="{Binding Name}"/>
                                                <Button Grid.Column="2" Classes="type-hint"
                                                        Content="(?)"
                                                        ToolTip.Tip="{Binding TypeHint}"
                                                        AutomationProperties.HelpText="{Binding TypeHint}"
                                                        IsVisible="{Binding HasTypeHint}"
                                                        AutomationProperties.Name="{DynamicResource AutomationName_ParameterHelp}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </StackPanel.Resources>

                <!-- ON ENTER -->
                <TextBlock Classes="section-header" Text="{DynamicResource Label_ScriptSection_Enter}"/>
                <ItemsControl ItemsSource="{Binding EnterRows}"
                              ItemTemplate="{StaticResource ScriptRowTemplate}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <AutoCompleteBox Grid.Column="0"
                             Text="{Binding NewEnterText, Mode=TwoWay}"
                             SelectedItem="{Binding SelectedEnterEntry, Mode=TwoWay}"
                             ItemsSource="{Binding AvailableScripts}"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             Watermark="{DynamicResource Placeholder_ScriptPicker}"
                             Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                             FontSize="{DynamicResource FontSize.Label}" Padding="6,4" MinWidth="0"
                             ToolTip.Tip="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.HelpText="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.Name="{DynamicResource Placeholder_ScriptPicker}"/>
                    <Button Classes="secondary" Grid.Column="1" Content="{DynamicResource Button_AddScript}"
                            Command="{Binding AddEnterScriptCommand}"
                            Padding="12,4" Margin="6,0,0,0" FontSize="{DynamicResource FontSize.Label}"
                            ToolTip.Tip="{DynamicResource ToolTip_AddScriptEnter}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_AddScriptEnter}"
                            AutomationProperties.Name="{DynamicResource AutomationName_AddScriptEnter}"/>
                </Grid>

                <!-- ON EXIT -->
                <TextBlock Classes="section-header" Text="{DynamicResource Label_ScriptSection_Exit}"/>
                <ItemsControl ItemsSource="{Binding ExitRows}"
                              ItemTemplate="{StaticResource ScriptRowTemplate}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <AutoCompleteBox Grid.Column="0"
                             Text="{Binding NewExitText, Mode=TwoWay}"
                             SelectedItem="{Binding SelectedExitEntry, Mode=TwoWay}"
                             ItemsSource="{Binding AvailableScripts}"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             Watermark="{DynamicResource Placeholder_ScriptPicker}"
                             Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                             FontSize="{DynamicResource FontSize.Label}" Padding="6,4" MinWidth="0"
                             ToolTip.Tip="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.HelpText="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.Name="{DynamicResource Placeholder_ScriptPicker}"/>
                    <Button Classes="secondary" Grid.Column="1" Content="{DynamicResource Button_AddScript}"
                            Command="{Binding AddExitScriptCommand}"
                            Padding="12,4" Margin="6,0,0,0" FontSize="{DynamicResource FontSize.Label}"
                            ToolTip.Tip="{DynamicResource ToolTip_AddScriptExit}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_AddScriptExit}"
                            AutomationProperties.Name="{DynamicResource AutomationName_AddScriptExit}"/>
                </Grid>

                <!-- ON UPDATE -->
                <TextBlock Classes="section-header" Text="{DynamicResource Label_ScriptSection_Update}"/>
                <ItemsControl ItemsSource="{Binding UpdateRows}"
                              ItemTemplate="{StaticResource ScriptRowTemplate}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <AutoCompleteBox Grid.Column="0"
                             Text="{Binding NewUpdateText, Mode=TwoWay}"
                             SelectedItem="{Binding SelectedUpdateEntry, Mode=TwoWay}"
                             ItemsSource="{Binding AvailableScripts}"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             Watermark="{DynamicResource Placeholder_ScriptPicker}"
                             Background="{DynamicResource Brush.Surface.Input}" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                             FontSize="{DynamicResource FontSize.Label}" Padding="6,4" MinWidth="0"
                             ToolTip.Tip="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.HelpText="{DynamicResource ToolTip_ScriptPicker}"
                             AutomationProperties.Name="{DynamicResource Placeholder_ScriptPicker}"/>
                    <Button Classes="secondary" Grid.Column="1" Content="{DynamicResource Button_AddScript}"
                            Command="{Binding AddUpdateScriptCommand}"
                            Padding="12,4" Margin="6,0,0,0" FontSize="{DynamicResource FontSize.Label}"
                            ToolTip.Tip="{DynamicResource ToolTip_AddScriptUpdate}"
                            AutomationProperties.HelpText="{DynamicResource ToolTip_AddScriptUpdate}"
                            AutomationProperties.Name="{DynamicResource AutomationName_AddScriptUpdate}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="footer-btn secondary" Content="{DynamicResource ScriptEditor_Cancel}"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="{DynamicResource ToolTip_ScriptEditorCancel}"
                        AutomationProperties.HelpText="{DynamicResource ToolTip_ScriptEditorCancel}" IsCancel="True"/>
                <Button Classes="footer-btn primary" Content="{DynamicResource ScriptEditor_OK}"
                        Command="{Binding ConfirmCommand}"
                        ToolTip.Tip="{DynamicResource ToolTip_ScriptEditorOK}"
                        AutomationProperties.HelpText="{DynamicResource ToolTip_ScriptEditorOK}"/>
            </StackPanel>
        </Border>

        <!-- Focus hint bar (Gaps item 13) -->
        <shared:FocusHintBar Grid.Row="2" x:Name="HintBar"/>

    </Grid>
</Window>
