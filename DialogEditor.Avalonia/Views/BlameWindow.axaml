<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DialogEditor.Avalonia.Views.BlameWindow"
        Title="{DynamicResource BlameWindow_Title}"
        Icon="avares://DialogEditor.Avalonia/Assets/app.ico"
        Width="780" Height="520" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Panel}">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <!-- Column headers (shown only when there are rows) -->
        <!-- Issue 178: the fixed columns take their width from ColumnWidth.* tokens, which scale
             with the font, so text no longer runs into the next column at large scales.
             Header and row cells share each token and the 8 px column spacing, and the header is
             inset by the row's 12 px item padding (Fluent's ListBoxItem), so the columns line up. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8"
              Margin="12,0,12,6" IsVisible="{Binding HasData}">
            <TextBlock Grid.Column="0" Width="{DynamicResource ColumnWidth.Conversation}" Text="{DynamicResource BlameWindow_ColConversation}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Width="{DynamicResource ColumnWidth.NodeId}" Text="{DynamicResource BlameWindow_ColNode}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Width="{DynamicResource ColumnWidth.Author}" Text="{DynamicResource BlameWindow_ColAuthor}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Width="{DynamicResource ColumnWidth.Date}" Text="{DynamicResource BlameWindow_ColDate}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
            <TextBlock Grid.Column="4" Width="{DynamicResource ColumnWidth.CommitSha}" Text="{DynamicResource BlameWindow_ColCommit}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
            <TextBlock Grid.Column="5" Text="{DynamicResource BlameWindow_ColMessage}"
                       Foreground="{DynamicResource Brush.Text.Caption}" FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource Brush.Text.Meta.Commit}" FontSize="{DynamicResource FontSize.Medium}" TextWrapping="Wrap"
                   IsVisible="{Binding !HasData}"
                   VerticalAlignment="Top"/>

        <ListBox Grid.Row="1" x:Name="BlameList"
                 ItemsSource="{Binding Rows}"
                 Background="{DynamicResource Brush.Surface.Card}" BorderThickness="0"
                 IsVisible="{Binding HasData}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8" Margin="0,3">
                        <TextBlock Grid.Column="0" Width="{DynamicResource ColumnWidth.Conversation}" Text="{Binding ConversationName}" ToolTip.Tip="{Binding ConversationName}"
                                   Classes="list-secondary" FontSize="{DynamicResource FontSize.Body}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Width="{DynamicResource ColumnWidth.NodeId}" Text="{Binding NodeId}"
                                   Classes="list-secondary" FontSize="{DynamicResource FontSize.Body}"/>
                        <TextBlock Grid.Column="2" Width="{DynamicResource ColumnWidth.Author}" Text="{Binding Author}" ToolTip.Tip="{Binding Author}"
                                   Classes="list-secondary" FontSize="{DynamicResource FontSize.Body}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Width="{DynamicResource ColumnWidth.Date}"
                                   Text="{Binding Date, Converter={StaticResource CommitDate}}"
                                   ToolTip.Tip="{Binding Date}"
                                   Classes="list-secondary" FontSize="{DynamicResource FontSize.Body}"/>
                        <TextBlock Grid.Column="4" Width="{DynamicResource ColumnWidth.CommitSha}" Text="{Binding ShortSha}"
                                   Classes="list-muted" FontSize="{DynamicResource FontSize.Body}" FontFamily="Consolas,monospace"/>
                        <TextBlock Grid.Column="5" Text="{Binding Subject}"
                                   Classes="list-primary" FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Classes="secondary" x:Name="CloseButton"
                    Content="{DynamicResource BlameWindow_Close}"
                    Padding="16,6" FontSize="{DynamicResource FontSize.Body}"/>
        </StackPanel>

    </Grid>

</Window>
