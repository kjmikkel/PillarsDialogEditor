<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DialogEditor.ViewModels;assembly=DialogEditor.ViewModels"
             xmlns:ctrl="clr-namespace:DialogEditor.Avalonia.Controls"
             x:Class="DialogEditor.Avalonia.Views.GameBrowserView" x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filter box -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" Padding="4" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Min, not fixed, sizes (issue 177): the text follows the font scale. -->
                <TextBox x:Name="FilterBox"
                         Text="{Binding FilterText}"
                         Watermark="{DynamicResource Placeholder_FilterConversations}"
                         Background="{DynamicResource Brush.Surface.Header}" Foreground="{DynamicResource Brush.Text.Secondary}" CaretBrush="{DynamicResource Brush.Text.Secondary}"
                         BorderBrush="{DynamicResource Brush.Border.Muted}" BorderThickness="1"
                         Padding="6,3,24,3" FontSize="{DynamicResource FontSize.Body}" MinHeight="26"
                         VerticalContentAlignment="Center"
                         KeyDown="FilterBox_KeyDown"
                         ToolTip.Tip="{DynamicResource ToolTip_FilterConversations}"
                         AutomationProperties.HelpText="{DynamicResource ToolTip_FilterConversations}"
                         AutomationProperties.Name="{DynamicResource Placeholder_FilterConversations}"/>
                <Button Command="{Binding ClearFilterCommand}"
                        HorizontalAlignment="Right" MinWidth="24" MinHeight="24"
                        Content="✕" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.Text.Hint}" FontSize="{DynamicResource FontSize.Small}" Cursor="Hand"
                        ToolTip.Tip="{DynamicResource ToolTip_ClearFilter}"
                        AutomationProperties.HelpText="{DynamicResource ToolTip_ClearFilter}"
                        AutomationProperties.Name="{DynamicResource AutomationName_ClearFilter}"/>
            </Grid>
        </Border>

        <!-- Conversation tree. It doesn't scroll sideways (issue 85): a long name trims with an
             ellipsis and shows in full in its tooltip, instead of running off the dock's edge. -->
        <ctrl:ConversationTreeView Grid.Row="1" Background="{DynamicResource Brush.Surface.Subtle}"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemsSource="{Binding FilteredRoots}"
                  SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                  SelectionChanged="TreeView_SelectionChanged">

            <ctrl:ConversationTreeView.Styles>
                <!-- Selection highlight -->
                <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}"/>
                </Style>
                <Style Selector="TreeViewItem:selected:focus /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}"/>
                </Style>

                <!-- Row label colours (issue #83). Set through STYLES, never as local
                     Foreground values on the TextBlocks: a local value outranks every style, so
                     the selected-row rule below could not replace it, and a selected row kept
                     its resting colour on the highlight (Light: dark grey on dark blue, ~1.5:1).
                     Order matters: the selected rule must come LAST so it wins over the resting
                     rules when both match. The 'selectedRow' class is bound per label to its OWN
                     row's container ($parent[TreeViewItem] is the nearest one), rather than
                     using a "TreeViewItem:selected TextBlock" selector, which would also recolour
                     every child row of a selected folder. -->
                <!-- Folders in strong, semi-bold text (issue 85): with every folder collapsed, which
                     is how the dock opens, they are all you see, and Text.Muted made them the
                     faintest text in the dock. Weight, not only colour, sets them apart. -->
                <Style Selector="TextBlock.folderLabel">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style Selector="TextBlock.conversationLabel">
                    <Setter Property="Foreground" Value="{Binding IsNew, Converter={StaticResource BoolToNewConversationBrush}}"/>
                </Style>
                <Style Selector="TextBlock.selectedRow">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Selection.Foreground}"/>
                </Style>
            </ctrl:ConversationTreeView.Styles>

            <ctrl:ConversationTreeView.DataTemplates>
                <!-- Folders nest, subfolders before conversations (issue 85, part B). -->
                <TreeDataTemplate DataType="{x:Type vm:ConversationFolderViewModel}" ItemsSource="{Binding Children}">
                    <!-- Body-size text (issue 85): the app's reading size, and it follows the font
                         scale. Padding 2,4 with the row's MinHeight 0 (below) gives a 24 px row at
                         1.0x, the WCAG 2.5.8 target size, that grows with the text. -->
                    <!-- The tooltip is the raw folder path (issue 85, part B): the label is tidied,
                         and a writer who knows the file layout can still see it. -->
                    <TextBlock Text="{Binding DisplayName}" Classes="folderLabel"
                               Classes.selectedRow="{Binding $parent[TreeViewItem].IsSelected}"
                               FontSize="{DynamicResource FontSize.Body}" Padding="2,4"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ToolTip}"/>
                </TreeDataTemplate>
                <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                    <TextBlock Text="{Binding DisplayName}" Classes="conversationLabel"
                               Classes.selectedRow="{Binding $parent[TreeViewItem].IsSelected}"
                               FontSize="{DynamicResource FontSize.Body}" Padding="2,4"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DisplayName}"
                               Cursor="Hand"
                               Tapped="ConversationItem_Tapped"/>
                </DataTemplate>
            </ctrl:ConversationTreeView.DataTemplates>

            <ctrl:ConversationTreeView.ItemContainerTheme>
                <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <!-- Fluent's 32 px row floor held 12 px text in wide empty bands (issue 85).
                         The label's padding sets the height instead; see the row templates. -->
                    <Setter Property="MinHeight" Value="0"/>
                    <!-- Name the CONTAINER, not just the templated TextBlock inside it
                         (issue #15 finding 1). Without this a TreeViewItem's accessible name
                         is empty and the label lives only on its child Text element, so a
                         screen reader announces nothing for the row and an automation lookup
                         for a conversation resolves to that inner Text — which cannot be
                         selected or expanded. DisplayName is data, not UI chrome, so a
                         binding is the correct source here rather than a localised resource. -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                </ControlTheme>
            </ctrl:ConversationTreeView.ItemContainerTheme>

        </ctrl:ConversationTreeView>

        <!-- Game name footer -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Card}" Padding="8,5">
            <!-- Small, not Caption (issue 85): 9 px was the smallest text in the app. -->
            <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource Brush.Text.Hint}" FontSize="{DynamicResource FontSize.Small}"/>
        </Border>
    </Grid>
</UserControl>
